{ ============================================================================
  FixBoard.pas  —  Altium DelphiScript
  Repairs the six defects found in pcb-initial-failure.PcbDoc.

  Run: Altium -> File > Open (this .pas) -> F9, or DXP > Run Script > FixBoard

  WHAT IT DOES
    1. deletes every track + via  (all routing is invalid once U1 moves)
    2. deletes the 14 wrong U1-* pads
    3. places 61 correct U1 pads   (48 perimeter 0.8x0.4 on 0.8 pitch,
       9 thermal 1.45 sq, 4 corner 0.7 sq) ALREADY ROTATED 180 about the
       module BODY centre (100.0, 8.8) so the antenna faces away from the
       J4/J11 pogo pads.  Rotating about the pad-ring centre instead would
       hang the antenna 5 mm off the board edge.
    4. corrects U2's 5 pads: 0.36 x 0.30 at +-0.421 / +-0.325, thermal
       0.48 sq ROTATED 45 with -0.05 mm solder mask expansion (that mask web
       is what stops the 0.054 mm copper gap bridging at reflow)
    5. corrects C1..C4 pad sizes and moves C3/C4 apart (the real 0805 land is
       3.41 mm long; at the old 3.2 mm spacing the two lands overlapped)
    6. sets U1-5 (GPIO2) and U1-22 (GPIO8) to +3V3 - both are strapping pins
       with no internal pull (Espressif datasheet Table 4-1)

  All geometry comes from footprints_lcsc.py, pulled from JLCPCB/LCSC's own
  library for C2838502 / C46459900 / C52923 / C16780.
  ============================================================================ }

Var
    Board : IPCB_Board;
    Comp  : IPCB_Component;

Function FindNet(name : TPCBString) : IPCB_Net;
Var It : IPCB_BoardIterator; N : IPCB_Net;
Begin
    Result := Nil;
    If name = '' Then Exit;
    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eNetObject));
    It.AddFilter_LayerSet(AllLayers);
    N := It.FirstPCBObject;
    While N <> Nil Do
    Begin
        If N.Name = name Then Begin Result := N; Break; End;
        N := It.NextPCBObject;
    End;
    Board.BoardIterator_Destroy(It);
End;

Procedure AddPad(nm : TPCBString; x, y, xs, ys, rt : Double; net : TPCBString);
Var P : IPCB_Pad;
Begin
    P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
    P.X         := MMsToCoord(x);
    P.Y         := MMsToCoord(y);
    P.TopXSize  := MMsToCoord(xs);
    P.TopYSize  := MMsToCoord(ys);
    P.TopShape  := eRectangular;
    P.HoleSize  := 0;
    P.Layer     := eTopLayer;
    P.Name      := nm;
    P.Rotation  := rt;
    P.Net       := FindNet(net);
    If Comp <> Nil Then Comp.AddPCBObject(P) Else Board.AddPCBObject(P);
    PCBServer.SendMessageToRobots(Board.I_ObjectAddress, c_Broadcast,
                                  PCBM_BoardRegisteration, P.I_ObjectAddress);
End;

Procedure SetPad(nm : TPCBString; x, y, xs, ys, rt, mask : Double);
Var It : IPCB_BoardIterator; P : IPCB_Pad;
Begin
    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(ePadObject));
    It.AddFilter_LayerSet(AllLayers);
    P := It.FirstPCBObject;
    While P <> Nil Do
    Begin
        If P.Name = nm Then
        Begin
            PCBServer.SendMessageToRobots(P.I_ObjectAddress, c_Broadcast,
                                          PCBM_BeginModify, c_NoEventData);
            P.X := MMsToCoord(x);   P.Y := MMsToCoord(y);
            P.TopXSize := MMsToCoord(xs); P.TopYSize := MMsToCoord(ys);
            P.TopShape := eRectangular;   P.Rotation := rt;
            If mask <> 0 Then
            Begin
                P.SolderMaskExpansionMode := eMaskExpansion_Manual;
                P.SolderMaskExpansion     := MMsToCoord(mask);
            End;
            PCBServer.SendMessageToRobots(P.I_ObjectAddress, c_Broadcast,
                                          PCBM_EndModify, c_NoEventData);
            Break;
        End;
        P := It.NextPCBObject;
    End;
    Board.BoardIterator_Destroy(It);
End;

Procedure SetPadNet(nm, net : TPCBString);
Var It : IPCB_BoardIterator; P : IPCB_Pad;
Begin
    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(ePadObject));
    It.AddFilter_LayerSet(AllLayers);
    P := It.FirstPCBObject;
    While P <> Nil Do
    Begin
        If P.Name = nm Then Begin P.Net := FindNet(net); Break; End;
        P := It.NextPCBObject;
    End;
    Board.BoardIterator_Destroy(It);
End;

Procedure FixBoard;
Var
    It   : IPCB_BoardIterator;
    Obj  : IPCB_Primitive;
    P    : IPCB_Pad;
    Kill : TInterfaceList;
    i, nTrk, nPad : Integer;
Begin
    Board := PCBServer.GetCurrentPCBBoard;
    If Board = Nil Then Begin ShowMessage('Open the PCB first.'); Exit; End;
    PCBServer.PreProcess;

    { --- 1. remove ALL routing: every trace that lands on U1/U2 is invalid --- }
    Kill := TInterfaceList.Create; nTrk := 0;
    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eTrackObject, eViaObject, eArcObject));
    It.AddFilter_LayerSet(MkSet(eTopLayer, eBottomLayer));
    Obj := It.FirstPCBObject;
    While Obj <> Nil Do Begin Kill.Add(Obj); Obj := It.NextPCBObject; End;
    Board.BoardIterator_Destroy(It);
    For i := 0 To Kill.Count - 1 Do
    Begin Board.RemovePCBObject(Kill.Items[i]); Inc(nTrk); End;
    Kill.Free;

    { --- 2. remove the 14 wrong U1 pads, remembering their owner --- }
    Kill := TInterfaceList.Create; nPad := 0; Comp := Nil;
    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(ePadObject));
    It.AddFilter_LayerSet(AllLayers);
    P := It.FirstPCBObject;
    While P <> Nil Do
    Begin
        If Copy(P.Name, 1, 3) = 'U1-' Then
        Begin
            If Comp = Nil Then Comp := P.Component;
            Kill.Add(P);
        End;
        P := It.NextPCBObject;
    End;
    Board.BoardIterator_Destroy(It);
    For i := 0 To Kill.Count - 1 Do
    Begin
        P := Kill.Items[i];
        If Comp <> Nil Then Comp.RemovePCBObject(P);
        Board.RemovePCBObject(P);
        Inc(nPad);
    End;
    Kill.Free;

    { --- 3. place the 61 correct U1 pads (already rotated 180) --- }
  AddPad('1', 105.9000, 7.5000, 0.8000, 0.4000, 0, 'GND');
  AddPad('2', 105.9000, 8.3001, 0.8000, 0.4000, 0, 'GND');
  AddPad('3', 105.9000, 9.1000, 0.8000, 0.4000, 0, '+3V3');
  AddPad('4', 105.9000, 9.9001, 0.8000, 0.4000, 0, '');
  AddPad('5', 105.9000, 10.6999, 0.8000, 0.4000, 0, '+3V3');
  AddPad('6', 105.9000, 11.5000, 0.8000, 0.4000, 0, 'FP_INT');
  AddPad('7', 105.9000, 12.3001, 0.8000, 0.4000, 0, '');
  AddPad('8', 105.9000, 13.0999, 0.8000, 0.4000, 0, '+3V3');
  AddPad('9', 105.9000, 13.9000, 0.8000, 0.4000, 0, '');
  AddPad('10', 105.9000, 14.6999, 0.8000, 0.4000, 0, '');
  AddPad('11', 105.9000, 15.5000, 0.8000, 0.4000, 0, 'GND');
  AddPad('12', 104.8001, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('13', 104.0000, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('14', 103.1999, 16.4000, 0.4000, 0.8000, 0, 'GND');
  AddPad('15', 102.4000, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('16', 101.5999, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('17', 100.8001, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('18', 100.0000, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('19', 99.1999, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('20', 98.4001, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('21', 97.6000, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('22', 96.8001, 16.4000, 0.4000, 0.8000, 0, '+3V3');
  AddPad('23', 96.0000, 16.4000, 0.4000, 0.8000, 0, 'BOOT_IO9');
  AddPad('24', 95.1999, 16.4000, 0.4000, 0.8000, 0, '');
  AddPad('25', 94.1000, 15.5000, 0.8000, 0.4000, 0, '');
  AddPad('26', 94.1000, 14.6999, 0.8000, 0.4000, 0, 'USB_DN');
  AddPad('27', 94.1000, 13.9000, 0.8000, 0.4000, 0, 'USB_DP');
  AddPad('28', 94.1000, 13.0999, 0.8000, 0.4000, 0, '');
  AddPad('29', 94.1000, 12.3001, 0.8000, 0.4000, 0, '');
  AddPad('30', 94.1000, 11.5000, 0.8000, 0.4000, 0, 'FP_TX');
  AddPad('31', 94.1000, 10.6999, 0.8000, 0.4000, 0, 'FP_RX');
  AddPad('32', 94.1000, 9.9001, 0.8000, 0.4000, 0, '');
  AddPad('33', 94.1000, 9.1000, 0.8000, 0.4000, 0, '');
  AddPad('34', 94.1000, 8.3001, 0.8000, 0.4000, 0, '');
  AddPad('35', 94.1000, 7.5000, 0.8000, 0.4000, 0, '');
  AddPad('36', 95.1999, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('37', 96.0000, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('38', 96.8001, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('39', 97.6000, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('40', 98.4001, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('41', 99.1999, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('42', 100.0000, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('43', 100.8001, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('44', 101.5999, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('45', 102.4000, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('46', 103.1999, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('47', 104.0000, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('48', 104.8001, 6.6000, 0.4000, 0.8000, 0, 'GND');
  AddPad('49', 101.9752, 9.5250, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 100.0000, 9.5250, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 98.0251, 9.5250, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 101.9752, 11.5000, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 100.0000, 11.5000, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 98.0251, 11.5000, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 101.9752, 13.4751, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 100.0000, 13.4751, 1.4500, 1.4500, 0, 'GND');
  AddPad('49', 98.0251, 13.4751, 1.4500, 1.4500, 0, 'GND');
  AddPad('50', 94.0500, 6.5500, 0.7000, 0.7000, 0, 'GND');
  AddPad('51', 94.0500, 16.4500, 0.7000, 0.7000, 0, 'GND');
  AddPad('52', 105.9500, 16.4500, 0.7000, 0.7000, 0, 'GND');
  AddPad('53', 105.9500, 6.5500, 0.7000, 0.7000, 0, 'GND');

    { --- 4 + 5. correct U2 and C1..C4 in place --- }
  SetPad('U2-1', 91.9790, 12.1250, 0.36, 0.3, 0, 0);
  SetPad('U2-2', 91.9790, 11.4750, 0.36, 0.3, 0, 0);
  SetPad('U2-3', 92.8210, 11.4750, 0.36, 0.3, 0, 0);
  SetPad('U2-4', 92.8210, 12.1250, 0.36, 0.3, 0, 0);
  SetPad('U2-5', 92.4000, 11.8000, 0.48, 0.48, 45, -0.05);
  SetPad('C1-1', 92.4000, 14.0201, 0.54, 0.5, 0, 0);
  SetPad('C1-2', 92.4000, 13.1799, 0.54, 0.5, 0, 0);
  SetPad('C2-1', 92.4000, 15.9201, 0.54, 0.5, 0, 0);
  SetPad('C2-2', 92.4000, 15.0799, 0.54, 0.5, 0, 0);
  SetPad('C3-1', 107.6000, 12.9000, 1.35, 1.41, 0, 0);
  SetPad('C3-2', 107.6000, 10.9000, 1.35, 1.41, 0, 0);
  SetPad('C4-1', 107.6000, 16.5100, 1.35, 1.41, 0, 0);
  SetPad('C4-2', 107.6000, 14.5100, 1.35, 1.41, 0, 0);

    { --- 6. strapping pins --- }
    SetPadNet('U1-5',  '+3V3');
    SetPadNet('U1-22', '+3V3');

    PCBServer.PostProcess;
    Board.ViewManager_FullUpdate;
    Client.SendMessage('PCB:Zoom', 'Action=Redraw', 255, Client.CurrentView);
    ShowMessage('Done.  Removed ' + IntToStr(nTrk) + ' routing objects and ' +
                IntToStr(nPad) + ' old U1 pads; placed 61 new U1 pads.' + #13#10 +
                'Next: ground pours, re-route, DRC.');
End;
